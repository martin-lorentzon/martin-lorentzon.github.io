{
  "name": "daisyui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Plain-HTML demo project using Tailwind CSS and daisyUI, compiled with the Tailwind CLI.",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch=always --poll"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans": "^5.3.1",
    "@tailwindcss/cli": "^4",
    "daisyui": "^5",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "lucide": "^1.43.0",
    "three": "^0.186.0"
  }
}
